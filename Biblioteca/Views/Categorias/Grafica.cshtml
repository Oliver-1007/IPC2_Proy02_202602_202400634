@{
    ViewData["Title"] = "Estructura gráfica";
}

<section class="tarjeta">
    <h1>
        Estructura gráfica
        @(ViewBag.NombreCategoria != null ? $"de \"{ViewBag.NombreCategoria}\"" : "del catálogo")
    </h1>

    @if (ViewBag.Error != null)
    {
        <p class="alerta alerta-error">@ViewBag.Error</p>
        <p>Verifique que Graphviz (comando <code>dot</code>) esté instalado y disponible en el PATH del sistema.</p>
    }
    else
    {
        <img class="imagen-grafica" src="@ViewBag.RutaImagen" alt="Estructura del catálogo" />
    }

    <p><a asp-controller="Categorias" asp-action="Estructura" class="boton boton-secundario">Volver a la estructura</a></p>
</section>