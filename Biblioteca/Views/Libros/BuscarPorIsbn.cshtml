@{
    ViewData["Title"] = "Buscar libro por ISBN";
}

<section class="tarjeta">
    <h1>Buscar libro por ISBN</h1>

    <form asp-controller="Libros" asp-action="BuscarPorIsbn" method="get" class="formulario-linea">
        <input type="number" name="isbn" placeholder="ISBN" value="@ViewBag.IsbnBuscado" required />
        <button type="submit" class="boton">Buscar</button>
    </form>

    @if (ViewBag.IsbnBuscado != null)
    {
        var libro = ViewBag.Libro as Biblioteca.Models.Libro;
        if (libro != null)
        {
            <table class="tabla-datos">
                <tr><th>ISBN</th><td>@libro.Isbn</td></tr>
                <tr><th>Título</th><td>@libro.Titulo</td></tr>
                <tr><th>Autor</th><td>@libro.Autor</td></tr>
                <tr><th>Categoría</th><td>@libro.CategoriaAsignada.Nombre</td></tr>
            </table>
        }
        else
        {
            <p class="alerta alerta-error">No se encontró ningún libro con ISBN @ViewBag.IsbnBuscado.</p>
        }
    }
</section>