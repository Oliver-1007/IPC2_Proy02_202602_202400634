@{
    ViewData["Title"] = "Eliminar libro";
}

<section class="tarjeta">
    <h1>Eliminar libro</h1>

    <form asp-controller="Libros" asp-action="Eliminar" method="post" class="formulario">
        <label for="isbn">ISBN del libro a eliminar</label>
        <input type="number" id="isbn" name="isbn" required />

        <button type="submit" class="boton boton-peligro">Eliminar</button>
    </form>
</section>