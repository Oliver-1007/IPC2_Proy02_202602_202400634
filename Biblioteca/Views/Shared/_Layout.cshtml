<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Catálogo de Librería</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="encabezado">
        <div class="contenedor">
            <a class="marca" asp-controller="Home" asp-action="Index">Catálogo de Librería</a>
            <nav class="menu">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <a asp-controller="Home" asp-action="CargarXml">Cargar XML</a>
                <a asp-controller="Categorias" asp-action="Estructura">Categorías</a>
                <a asp-controller="Categorias" asp-action="AgregarCategoria">Agregar categoría</a>
                <a asp-controller="Libros" asp-action="Registrar">Registrar libro</a>
                <a asp-controller="Libros" asp-action="Eliminar">Eliminar libro</a>
                <a asp-controller="Libros" asp-action="BuscarPorIsbn">Buscar por ISBN</a>
                <a asp-controller="Libros" asp-action="Listado">Listado de libros</a>
                <a asp-controller="Home" asp-action="Ayuda">Ayuda</a>
            </nav>
        </div>
    </header>

    <main class="contenedor contenido">
        @{
            bool hayMensaje = TempData["Mensaje"] != null;
            bool exito = TempData["Exito"] as bool? ?? false;
        }
        @if (hayMensaje)
        {
            <div class="alerta @(exito ? "alerta-exito" : "alerta-error")">
                @TempData["Mensaje"]
            </div>
        }
        @RenderBody()
    </main>

    <footer class="pie">
        <div class="contenedor">
            Proyecto 2 · IPC2 · Universidad de San Carlos de Guatemala
        </div>
    </footer>
</body>
</html>